NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth credentials belong in Supabase Auth provider settings, not this file.
# See docs/AUTHENTICATION.md for local callback configuration.
# Used only by the chatbot and its moderation check.
GEMINI_API_KEY=

# Server-only settings. npm run dev creates a secret in .env.local if absent.
ML_SERVICE_URL=http://127.0.0.1:8010
ML_SERVICE_TOKEN=
# Optional separate encryption secret (32+ characters); defaults to the service token.
ML_ASSESSMENT_SECRET=
# Private URL /demo/<key>; generated on first npm run dev. Server only.
# Rotate this hex key to invalidate an old entry URL.
DEMO_ENTRY_KEY=
# Temporary staff demo passwords, generated locally by npm run dev.
DEMO_ADMIN_PASSWORD=
DEMO_MENTOR_PASSWORD=
DEMO_MENTOR2_PASSWORD=

# Required for real assessment/roadmap writes in local and cloud deployments.
# Server-side Secret; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Optional release cutover pause. Set to 1 only during a documented migration.
# Applies to learning APIs, including grading; leave unset during normal operation.
LEARNING_MAINTENANCE=
# Vercel Services injects ML_SERVICE_URL through the private service binding.
